<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE ejb-jar
    PUBLIC "-//Sun Microsystems, Inc.//DTD Enterprise JavaBeans 2.0//EN"
    "http://java.sun.com/dtd/ejb-jar_2_0.dtd">

<!--
  The EJB container's deployment descriptor - the counterpart to web.xml.
  This is the whole point of the comparison: web.xml declares how requests
  reach code, while ejb-jar.xml declares what the container does AROUND your
  code once it gets there: transactions, security and lifecycle.

  Nothing here is a servlet concept. There is no equivalent of
  <container-transaction> in the servlet container; if you want a transaction
  there, you write it by hand.
-->
<ejb-jar>

  <display-name>eBay business tier</display-name>

  <enterprise-beans>

    <session>
      <description>Bidding operations, moved out of the web tier.</description>
      <ejb-name>Bidding</ejb-name>
      <local-home>com.ebay.ejb.BiddingLocalHome</local-home>
      <local>com.ebay.ejb.BiddingLocal</local>
      <ejb-class>com.ebay.ejb.BiddingBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
      <resource-ref>
        <res-ref-name>jdbc/ebayDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
      </resource-ref>
    </session>

    <session>
      <description>Conversational watch list held in the business tier.</description>
      <ejb-name>WatchList</ejb-name>
      <local-home>com.ebay.ejb.WatchListLocalHome</local-home>
      <local>com.ebay.ejb.WatchListLocal</local>
      <ejb-class>com.ebay.ejb.WatchListBean</ejb-class>
      <session-type>Stateful</session-type>
      <transaction-type>Container</transaction-type>
    </session>


    <entity>
      <description>A listing, persisted by the container.</description>
      <ejb-name>ItemEntity</ejb-name>
      <local-home>com.ebay.cmp.ItemLocalHome</local-home>
      <local>com.ebay.cmp.ItemLocal</local>
      <ejb-class>com.ebay.cmp.ItemBean</ejb-class>
      <persistence-type>Container</persistence-type>
      <prim-key-class>java.lang.Long</prim-key-class>
      <reentrant>False</reentrant>
      <cmp-version>2.x</cmp-version>
      <abstract-schema-name>ItemSchema</abstract-schema-name>
      <cmp-field><field-name>id</field-name></cmp-field>
      <cmp-field><field-name>title</field-name></cmp-field>
      <cmp-field><field-name>seller</field-name></cmp-field>
      <cmp-field><field-name>categoryId</field-name></cmp-field>
      <cmp-field><field-name>currentCents</field-name></cmp-field>
      <cmp-field><field-name>bidCount</field-name></cmp-field>
      <primkey-field>id</primkey-field>

      <query>
        <query-method><method-name>findAll</method-name><method-params/></query-method>
        <ejb-ql>SELECT OBJECT(i) FROM ItemSchema i</ejb-ql>
      </query>
      <query>
        <query-method>
          <method-name>findByCategory</method-name>
          <method-params><method-param>java.lang.Integer</method-param></method-params>
        </query-method>
        <ejb-ql>SELECT OBJECT(i) FROM ItemSchema i WHERE i.categoryId = ?1</ejb-ql>
      </query>
      <query>
        <query-method>
          <method-name>findDearerThan</method-name>
          <method-params><method-param>java.lang.Long</method-param></method-params>
        </query-method>
        <ejb-ql>SELECT OBJECT(i) FROM ItemSchema i WHERE i.currentCents &gt; ?1</ejb-ql>
      </query>
      <query>
        <query-method>
          <method-name>findByTitleLike</method-name>
          <method-params><method-param>java.lang.String</method-param></method-params>
        </query-method>
        <ejb-ql>SELECT OBJECT(i) FROM ItemSchema i WHERE i.title LIKE ?1</ejb-ql>
      </query>
      <query>
        <query-method>
          <method-name>findBySeller</method-name>
          <method-params><method-param>java.lang.String</method-param></method-params>
        </query-method>
        <ejb-ql>SELECT OBJECT(i) FROM ItemSchema i WHERE i.seller = ?1</ejb-ql>
      </query>
    </entity>

    <entity>
      <description>A bid. The many side of the relationship.</description>
      <ejb-name>BidEntity</ejb-name>
      <local-home>com.ebay.cmp.BidLocalHome</local-home>
      <local>com.ebay.cmp.BidLocal</local>
      <ejb-class>com.ebay.cmp.BidBean</ejb-class>
      <persistence-type>Container</persistence-type>
      <prim-key-class>java.lang.Long</prim-key-class>
      <reentrant>False</reentrant>
      <cmp-version>2.x</cmp-version>
      <abstract-schema-name>BidSchema</abstract-schema-name>
      <cmp-field><field-name>id</field-name></cmp-field>
      <cmp-field><field-name>bidder</field-name></cmp-field>
      <cmp-field><field-name>priceCents</field-name></cmp-field>
      <cmp-field><field-name>placedAt</field-name></cmp-field>
      <primkey-field>id</primkey-field>
      <query>
        <query-method><method-name>findAll</method-name><method-params/></query-method>
        <ejb-ql>SELECT OBJECT(b) FROM BidSchema b</ejb-ql>
      </query>
      <query>
        <query-method>
          <method-name>findByBidder</method-name>
          <method-params><method-param>java.lang.String</method-param></method-params>
        </query-method>
        <ejb-ql>SELECT OBJECT(b) FROM BidSchema b WHERE b.bidder = ?1</ejb-ql>
      </query>
    </entity>

    <session>
      <description>Session facade in front of the entity beans.</description>
      <ejb-name>Catalog</ejb-name>
      <local-home>com.ebay.cmp.CatalogLocalHome</local-home>
      <local>com.ebay.cmp.CatalogLocal</local>
      <ejb-class>com.ebay.cmp.CatalogBean</ejb-class>
      <session-type>Stateless</session-type>
      <transaction-type>Container</transaction-type>
      <ejb-local-ref>
        <ejb-ref-name>ejb/ItemEntity</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <local-home>com.ebay.cmp.ItemLocalHome</local-home>
        <local>com.ebay.cmp.ItemLocal</local>
        <ejb-link>ItemEntity</ejb-link>
      </ejb-local-ref>
      <ejb-local-ref>
        <ejb-ref-name>ejb/BidEntity</ejb-ref-name>
        <ejb-ref-type>Entity</ejb-ref-type>
        <local-home>com.ebay.cmp.BidLocalHome</local-home>
        <local>com.ebay.cmp.BidLocal</local>
        <ejb-link>BidEntity</ejb-link>
      </ejb-local-ref>
    </session>

  </enterprise-beans>

  <!--
    Container-managed relationships. The foreign key, the join and the
    cascade are all declared here; no Java in this project mentions them.
  -->
  <relationships>
    <ejb-relation>
      <ejb-relation-name>Item-Bids</ejb-relation-name>
      <ejb-relationship-role>
        <ejb-relationship-role-name>item-has-bids</ejb-relationship-role-name>
        <multiplicity>One</multiplicity>
        <relationship-role-source><ejb-name>ItemEntity</ejb-name></relationship-role-source>
        <cmr-field>
          <cmr-field-name>bids</cmr-field-name>
          <cmr-field-type>java.util.Collection</cmr-field-type>
        </cmr-field>
      </ejb-relationship-role>
      <ejb-relationship-role>
        <ejb-relationship-role-name>bid-belongs-to-item</ejb-relationship-role-name>
        <multiplicity>Many</multiplicity>
        <cascade-delete/>
        <relationship-role-source><ejb-name>BidEntity</ejb-name></relationship-role-source>
        <cmr-field>
          <cmr-field-name>item</cmr-field-name>
        </cmr-field>
      </ejb-relationship-role>
    </ejb-relation>
  </relationships>

  <assembly-descriptor>

    <!--
      Declarative security. Left unchecked so the demonstration stays open,
      but this is where <role-name> would replace the filter you would
      otherwise write in the web tier.
    -->
    <method-permission>
      <unchecked/>
      <method>
        <ejb-name>Bidding</ejb-name>
        <method-name>*</method-name>
      </method>
    </method-permission>
    <method-permission>
      <unchecked/>
      <method>
        <ejb-name>WatchList</ejb-name>
        <method-name>*</method-name>
      </method>
    </method-permission>

    <!--
      Declarative transactions. Every method of Bidding runs inside a
      container transaction: it starts one if none exists and joins the
      caller's if there is one. A system exception thrown from the bean
      rolls it back, with no commit or rollback written in Java anywhere.
    -->
    <container-transaction>
      <method>
        <ejb-name>Bidding</ejb-name>
        <method-name>*</method-name>
      </method>
      <trans-attribute>Required</trans-attribute>
    </container-transaction>

    <container-transaction>
      <method>
        <ejb-name>WatchList</ejb-name>
        <method-name>*</method-name>
      </method>
      <trans-attribute>Supports</trans-attribute>
    </container-transaction>

    <container-transaction>
      <method>
        <ejb-name>Catalog</ejb-name>
        <method-name>*</method-name>
      </method>
      <trans-attribute>Required</trans-attribute>
    </container-transaction>

    <container-transaction>
      <method>
        <ejb-name>ItemEntity</ejb-name>
        <method-name>*</method-name>
      </method>
      <trans-attribute>Required</trans-attribute>
    </container-transaction>

    <container-transaction>
      <method>
        <ejb-name>BidEntity</ejb-name>
        <method-name>*</method-name>
      </method>
      <trans-attribute>Required</trans-attribute>
    </container-transaction>

  </assembly-descriptor>

</ejb-jar>
